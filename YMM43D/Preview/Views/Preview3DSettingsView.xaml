<UserControl x:Class="YMM43D.Preview.Views.Preview3DSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YMM43D.Preview.Views"
             xmlns:viewmodels="clr-namespace:YMM43D.Preview.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:Preview3DSettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel Margin="10">
        <TextBlock Text="シーンカメラ (出力用)" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" FontSize="14"/>
        
        <TextBlock Text="水平回転" Foreground="#AAA" FontSize="11" Margin="0,5,0,2"/>
        <Slider Minimum="-3.14" Maximum="3.14" Value="{Binding Camera.CameraYaw}"/>
        
        <TextBlock Text="垂直回転" Foreground="#AAA" FontSize="11" Margin="0,5,0,2"/>
        <Slider Minimum="-1.5" Maximum="1.5" Value="{Binding Camera.CameraPitch}"/>
        
        <TextBlock Text="回転角 (Roll)" Foreground="#AAA" FontSize="11" Margin="0,5,0,2"/>
        <Slider Minimum="-3.14" Maximum="3.14" Value="{Binding Camera.CameraRoll}"/>
        
        <TextBlock Text="距離" Foreground="#AAA" FontSize="11" Margin="0,5,0,2"/>
        <Slider Minimum="0.1" Maximum="100" Value="{Binding Camera.CameraDistance}"/>
        
        <Button Content="カメラをリセット" 
                Command="{Binding DataContext.ResetCameraCommand, RelativeSource={RelativeSource AncestorType=local:Preview3DSidebar}}" 
                Margin="0,15,0,0" Height="24"/>
    </StackPanel>
</UserControl>
