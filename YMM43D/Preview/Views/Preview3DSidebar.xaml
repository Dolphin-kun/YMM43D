<UserControl x:Class="YMM43D.Preview.Views.Preview3DSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YMM43D.Preview.Views"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <UserControl.Resources>
        <local:IconResourceConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 垂直トグルボタン (Menuタブ) -->
        <Button Grid.Column="0" 
                Command="{Binding ToggleSettingsCommand}"
                Width="32" VerticalAlignment="Top" Margin="0,48,0,0"
                Background="#3F3F3F" BorderBrush="#555" BorderThickness="1,1,0,1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8,0,0,8"
                            Padding="0,8">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center">
                <!-- 
                    アイコンの白色化：OpacityMaskを使用して確実に白く表示します
                -->
                <Border Background="White" Width="14" Height="14" Margin="0,0,0,6">
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="{Binding IsSettingsVisible, Converter={StaticResource IconConverter}}"/>
                    </Border.OpacityMask>
                </Border>
                
                <TextBlock Text="Menu" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Button>

        <!-- 設定パネル本体 -->
        <Border Grid.Column="1" 
                Width="220" Background="#262626" BorderBrush="#3F3F3F" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Blenderの 'Lock Camera to View' に相当する機能 -->
                <CheckBox Content="出力カメラの視点で表示" 
                          IsChecked="{Binding IsLockToCamera}"
                          Foreground="White" Margin="0,0,0,15"/>

                <local:Preview3DSettingsView DataContext="{Binding SettingsViewModel}"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
