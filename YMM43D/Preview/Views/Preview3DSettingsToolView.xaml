<UserControl x:Class="YMM43D.Preview.Views.Preview3DSettingsToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YMM43D.Preview.Views"
             xmlns:viewmodels="clr-namespace:YMM43D.Preview.ViewModels"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="シーンカメラ (出力用)" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                
                <TextBlock Text="水平回転 (Yaw)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.CameraYaw}" DefaultMin="-3600" DefaultMax="3600" DefaultValue="0"/>
                
                <TextBlock Text="垂直回転 (Pitch)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.CameraPitch}" DefaultMin="-90" DefaultMax="90" DefaultValue="0"/>
                
                <TextBlock Text="回転角 (Roll)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.CameraRoll}" DefaultMin="-3600" DefaultMax="3600" DefaultValue="0"/>
                
                <TextBlock Text="距離 (Distance)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.CameraDistance}" DefaultMin="0.1" DefaultMax="1000" DefaultValue="10"/>
                
                <Button Content="カメラをリセット" 
                        Command="{Binding ResetCameraCommand}" 
                        Margin="0,20,0,0" Height="28"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
