<UserControl x:Class="YMM43D.Controls.ShapeKeys.ShapeKeysEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.Controls.ShapeKeys"
             xmlns:s="clr-namespace:YMM43D.Project.Shape"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ShapeKeysEditorViewModel}"
             d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate DataType="{x:Type s:ShapeKey}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="名前"/>
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Text_GotKeyboardFocus" LostKeyboardFocus="Text_LostKeyboardFocus"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="効き"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding Value}" StringFormat="F1" Unit="%" DefaultMin="0" DefaultMax="100" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="KeyList"
                     Height="96"
                     SelectionMode="Single"
                     PreviewMouseWheel="KeyList_PreviewMouseWheel"
                     ItemsSource="{Binding Items}"
                     SelectedIndex="{Binding SelectedIndex}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type s:ShapeKey}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Value.Values[0].Value, StringFormat={}{0:F0}%}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1">
                <Button Style="{StaticResource SmallButton}" ToolTip="シェイプキーを足す（はじめは元の形と同じで、編集モードのサイドバーで選んで形を変えます）" Command="{Binding AddCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.Plus}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="選んだシェイプキーを消す" Command="{Binding RemoveCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.Minus}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="上へ" Command="{Binding MoveUpCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.MenuUp}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="下へ" Command="{Binding MoveDownCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.MenuDown}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl Margin="0,4,0,0" Content="{Binding Selected}" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}"/>
    </StackPanel>
</UserControl>
