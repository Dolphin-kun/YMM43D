<UserControl x:Class="YMM43D.Controls.ParentItem.ParentItemSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.Controls.ParentItem"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ParentItemSelectorViewModel}">
    <ComboBox x:Name="Choices"
              VerticalContentAlignment="Center"
              ItemsSource="{Binding Choices}"
              DisplayMemberPath="Name"
              SelectedValuePath="Value"
              SelectedValue="{Binding Selected}"
              DropDownOpened="Choices_DropDownOpened"/>
</UserControl>
