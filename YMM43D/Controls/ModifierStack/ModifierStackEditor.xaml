<UserControl x:Class="YMM43D.Controls.ModifierStack.ModifierStackEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.Controls.ModifierStack"
             xmlns:m="clr-namespace:YMM43D.Project.Shape.Modifiers"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ModifierStackEditorViewModel}"
             d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate DataType="{x:Type m:MirrorModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="X"/>
                    <c:ToggleSlider Grid.Column="1" Value="{Binding AxisX, Mode=TwoWay}" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="Y"/>
                    <c:ToggleSlider Grid.Column="1" Value="{Binding AxisY, Mode=TwoWay}" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="Z"/>
                    <c:ToggleSlider Grid.Column="1" Value="{Binding AxisZ, Mode=TwoWay}" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="はみ出しを切る"/>
                    <c:ToggleSlider Grid.Column="1" Value="{Binding Bisects, Mode=TwoWay}" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="くっつける距離"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding Merge}" StringFormat="F1" Unit="px" DefaultMin="0" DefaultMax="20" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SubdivisionModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="段数"/>
                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Levels, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="0" Max="5" DefaultMin="0" DefaultMax="5" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:ArrayModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="数"/>
                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Count, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="1" Max="50" DefaultMin="1" DefaultMax="50" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="ずらし X"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding RelativeX}" StringFormat="F1" Unit="%" DefaultMin="-200" DefaultMax="200" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="ずらし Y"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding RelativeY}" StringFormat="F1" Unit="%" DefaultMin="-200" DefaultMax="200" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="ずらし Z"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding RelativeZ}" StringFormat="F1" Unit="%" DefaultMin="-200" DefaultMax="200" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="足す X"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding ConstantX}" StringFormat="F1" Unit="px" DefaultMin="-500" DefaultMax="500" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="足す Y"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding ConstantY}" StringFormat="F1" Unit="px" DefaultMin="-500" DefaultMax="500" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="足す Z"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding ConstantZ}" StringFormat="F1" Unit="px" DefaultMin="-500" DefaultMax="500" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="くっつける"/>
                    <c:ToggleSlider Grid.Column="1" Value="{Binding Merges, Mode=TwoWay}" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="くっつける距離"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding MergeDistance}" StringFormat="F1" Unit="px" DefaultMin="0" DefaultMax="20" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SolidifyModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="厚み"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding Thickness}" StringFormat="F1" Unit="px" DefaultMin="-100" DefaultMax="100" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:BevelModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="量"/>
                    <c:AnimationSlider Grid.Column="1" Animation="{Binding Amount}" StringFormat="F1" Unit="px" DefaultMin="0" DefaultMax="50" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="段数"/>
                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Segments, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="1" Max="10" DefaultMin="1" DefaultMax="10" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="角度の下限"/>
                    <c:TextBoxSlider Grid.Column="1" Value="{Binding AngleLimit, Mode=TwoWay}" Unit="°" StringFormat="F0" Delta="1" Min="0" Max="180" DefaultMin="0" DefaultMax="180" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:BooleanModifier}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="種類"/>
                    <ComboBox VerticalContentAlignment="Center" Grid.Column="1" ItemsSource="{Binding DataContext.Operations, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Operation}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource RowLabel}" Content="相手のレイヤー"/>
                    <c:TextBoxSlider Grid.Column="1" Value="{Binding TargetLayer, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="0" Max="100" DefaultMin="0" DefaultMax="100" BeginEdit="Slider_BeginEdit" EndEdit="Slider_EndEdit"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:ArmatureModifier}">
            <TextBlock Margin="6,2" TextWrapping="Wrap" Text="「骨」の欄の骨とポーズに合わせて形を曲げるので、ほかのモディファイアより上に置いてください。"/>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ModifierList"
                     Height="120"
                     SelectionMode="Single"
                     PreviewMouseWheel="ModifierList_PreviewMouseWheel"
                     ItemsSource="{Binding Items}"
                     SelectedIndex="{Binding SelectedIndex}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:ShapeModifier}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="{Binding IsEnabled}" ToolTip="効かせるかどうか"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1">
                <ToggleButton x:Name="AddButton" Width="24" Height="24" ToolTip="モディファイアを足す" Checked="AddButton_Checked">
                    <Path Style="{StaticResource Icon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Data="{DynamicResource {x:Static icons:GeometryKeys.Plus}}"/>
                </ToggleButton>
                <Button Style="{StaticResource SmallButton}" ToolTip="選んだモディファイアを消す" Command="{Binding RemoveCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.Minus}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="上へ（先に掛ける）" Command="{Binding MoveUpCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.MenuUp}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="下へ（後で掛ける）" Command="{Binding MoveDownCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.MenuDown}}"/>
                </Button>
                <Button Style="{StaticResource SmallButton}" ToolTip="適用（いまの形に焼き込んで、このモディファイアを外す）" Command="{Binding ApplyCommand}">
                    <Path Style="{StaticResource Icon}" Data="{DynamicResource {x:Static icons:GeometryKeys.Check}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl Margin="0,4,0,0" Content="{Binding Selected}" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}"/>

        <Popup x:Name="Picker"
               PlacementTarget="{Binding ElementName=AddButton}"
               Placement="Bottom"
               StaysOpen="True"
               IsOpen="{Binding IsChecked, ElementName=AddButton}"
               Opened="Picker_Opened"
               Closed="Picker_Closed">
            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                <Grid Width="320" MinHeight="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <TextBlock Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5" Text="検索">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" PreviewKeyDown="CategoryList_PreviewKeyDown"/>
                    </DockPanel>

                    <ListBox x:Name="ChoiceList"
                             Grid.Column="1"
                             ItemsSource="{Binding Filtered}"
                             DisplayMemberPath="Name"
                             SelectedItem="{Binding Picked}"
                             MouseUp="ChoiceList_MouseUp"
                             PreviewKeyDown="ChoiceList_PreviewKeyDown"/>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
