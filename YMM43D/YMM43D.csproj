<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<Version>1.0.0</Version>

		<!--Pdb内にソースコードのフルパスを含めない-->
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
		<PathMap>$(RepoRoot)=.</PathMap>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="SharpGen.Runtime">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\SharpGen.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.D3DCompiler">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.D3DCompiler.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.Direct2D1">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.Direct2D1.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.Direct3D11">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.Direct3D11.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.DirectX">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.DirectX.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.DXGI">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.DXGI.dll</HintPath>
		</Reference>
		<Reference Include="Vortice.Mathematics">
		  <HintPath>..\..\..\..\YukkuriMovieMaker_v4_Lite_Plugin\Vortice.Mathematics.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Controls">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.Controls.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Plugin">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!--ビルド後にYMM4のプラグインフォルダにdllをコピーする-->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="mkdir &quot;$(YMM4DirPath)user\plugin\$(ProjectName)&quot; &gt; NUL 2&gt;&amp;1&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(YMM4DirPath)user\plugin\$(ProjectName)\&quot;" />
	</Target>
</Project>