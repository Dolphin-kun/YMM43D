<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DSettingsToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             xmlns:viewmodels="clr-namespace:YMM43D.PreviewTool.ViewModels"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="シーンカメラ (出力用)" FontWeight="Bold" Margin="0,0,0,4" FontSize="14"/>
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,0,0,15"
                           Text="ここの値はプロジェクトに保存されません。キーフレームを打ちたい場合や、設定を残したい場合は、タイムラインに「3Dカメラ」アイテムを置いてください。カメラアイテムがあるとそちらが優先されます。"/>
                
                <CheckBox Content="プレビュー画面のドラッグで操作する" 
                          IsChecked="{Binding Camera.IsControlledByPreviewDrag}" 
                          Margin="0,0,0,15"/>
                
                <TextBlock Text="水平回転 (Yaw)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.Yaw}" DefaultMin="-3600" DefaultMax="3600" DefaultValue="0"/>
                
                <TextBlock Text="垂直回転 (Pitch)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.Pitch}" DefaultMin="-90" DefaultMax="90" DefaultValue="0"/>
                
                <TextBlock Text="回転角 (Roll)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.Roll}" DefaultMin="-3600" DefaultMax="3600" DefaultValue="0"/>
                
                <TextBlock Text="遠近の強さ (Distance)" FontSize="11" Margin="0,5,0,2"/>
                <c:AnimationSlider Animation="{Binding Camera.Distance}" DefaultMin="0.1" DefaultMax="1000" DefaultValue="10"/>
                <TextBlock Text="寄り引きではありません。注視点の面にあるものは大きさが変わらず、手前と奥の差だけが変わります。"
                           FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                
                <Button Content="カメラをリセット" 
                        Command="{Binding ResetCameraCommand}" 
                        Margin="0,20,0,0" Height="28"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
