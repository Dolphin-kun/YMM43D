<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/YMM43D;component/PreviewTool/Views/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>

        <SolidColorBrush x:Key="ModeInk" Color="#FFECECEC"/>

        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource ModeInk}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>

        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Back"
                                     Fill="#B2202020"
                                     Stroke="#40FFFFFF"
                                     StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Stroke" Value="#C0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Fill" Value="#CCF57C00"/>
                                <Setter TargetName="Back" Property="Stroke" Value="#FFFFCC80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Back"
                                     Fill="#B2202020"
                                     Stroke="#40FFFFFF"
                                     StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Stroke" Value="#C0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Fill" Value="#CC1E88E5"/>
                                <Setter TargetName="Back" Property="Stroke" Value="#FF90CAF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PartButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3,0,3,4"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="Transparent"
              Margin="0"
              Padding="0"
              Focusable="False"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              KeyboardNavigation.ControlTabNavigation="None"
              KeyboardNavigation.DirectionalNavigation="None">
            <MenuItem Header="追加">
                <MenuItem Header="3Dカメラ"
                          Command="{Binding AddCameraCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3Dカメラ」アイテムを置きます。レイヤー番号がいちばん大きいものが使われます。"/>

                <MenuItem Header="3D光源"
                          Command="{Binding AddLightCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3D光源」アイテムを置きます。置いた分だけ足し合わさります。1つも置かなければ、決まった光が当たります。"/>

                <MenuItem Header="3D環境"
                          Command="{Binding AddEnvironmentCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3D環境」アイテムを置きます。環境光と霧を決めます。レイヤー番号がいちばん大きいものが使われます。"/>
            </MenuItem>

            <MenuItem Header="カメラ">
                <MenuItem Header="カメラ追従"
                          IsCheckable="True"
                          IsChecked="{Binding DrivesSceneCamera}"
                          InputGestureText="{Binding Keys[DriveSceneCamera]}"
                          ToolTip="入れると、見る位置がカメラアイテムに追従し、ドラッグがそのカメラを直接動かします。外すと見る位置だけが動き、出力は変わりません。入れている間はドラッグでアイテムを掴めません。動かすときは、選んでから軸ハンドルを掴んでください。"/>

                <MenuItem Header="ドラッグで中間点を打つ"
                          IsCheckable="True"
                          IsChecked="{Binding InsertsKeyFrame}"
                          InputGestureText="{Binding Keys[ToggleAutoKeyFrame]}"
                          ToolTip="入れると、ドラッグがいまの再生位置に中間点を打ち、そこだけを動かします。外すと、打ってある中間点すべてが同じだけ動きます。カメラにもアイテムにも効きます。"/>

                <MenuItem Header="現在の再生位置に中間点を追加"
                          Command="{Binding AddKeyFrameCommand}"
                          IsEnabled="{Binding HasSelectedItem}"
                          InputGestureText="{Binding Keys[AddKeyFrame]}"
                          ToolTip="YMM4 本体の「現在の再生位置に中間点を追加」を、選んでいるアイテムに対して実行します。アイテムを選んでいないときは押せません。"/>

                <MenuItem Header="視点をカメラに戻す"
                          Command="{Binding ResetToSceneCameraCommand}"
                          InputGestureText="{Binding Keys[ViewCamera]}"
                          ToolTip="プレビューで見る位置を、いまシーンを撮っているカメラの位置に合わせ直します。"/>
            </MenuItem>

            <MenuItem Header="表示">
                <MenuItem Header="グリッド"
                          IsCheckable="True"
                          IsChecked="{Binding ShowsGrid}"
                          InputGestureText="{Binding Keys[ToggleGrid]}"
                          ToolTip="床の格子と、原点を通る2本の座標軸を出すかどうか。動画の出力には関係ありません。"/>

                <MenuItem Header="モデルを網で出す"
                          IsCheckable="True"
                          IsChecked="{Binding ShowsMesh}"
                          InputGestureText="{Binding Keys[ToggleWireframe]}"
                          ToolTip="3Dモデルを面で塗らず、線だけ（網）で出します。体の中のボーンが見えるので、ボーンを掴みやすくなります。動画の出力には関係ありません。"/>
            </MenuItem>

            <MenuItem Header="編集">
                <MenuItem Header="すべて選ぶ"
                          Command="{Binding SelectAllCommand}"
                          InputGestureText="{Binding Keys[SelectAll]}"
                          ToolTip="3Dプレビューに出ているアイテムをすべて選びます。Ctrl を押しながらクリックすると、1つずつ足したり外したりできます。選んだものはまとめて動かせます。"/>

                <MenuItem Header="選択を解除"
                          Command="{Binding ClearSelectionCommand}"
                          InputGestureText="{Binding Keys[ClearSelection]}"/>

                <Separator/>

                <MenuItem Header="ローカル軸で動かす"
                          IsCheckable="True"
                          IsChecked="{Binding UsesLocalSpace}"
                          InputGestureText="{Binding Keys[ToggleLocalSpace]}"
                          ToolTip="入れると、軸ハンドルと回転の輪がそのアイテムの向きに沿います。外すと世界の軸に沿います。回したものを「その正面へ出す」ときに使ってください。"/>

                <Separator/>

                <MenuItem Header="編集モード"
                          IsCheckable="True"
                          IsChecked="{Binding IsEditingMesh}"
                          IsEnabled="{Binding CanEditMesh}"
                          InputGestureText="{Binding Keys[ToggleEditMode]}"
                          ToolTip="3Dアイテムを1つだけ選んでいるとき、その形そのものを編集します。頂点をドラッグすると形が変わります。"/>

                <MenuItem Header="選ぶ単位" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="頂点" IsCheckable="True" IsChecked="{Binding EditsVertices}"
                              InputGestureText="{Binding Keys[EditVertices]}"/>
                    <MenuItem Header="辺" IsCheckable="True" IsChecked="{Binding EditsEdges}"
                              InputGestureText="{Binding Keys[EditEdges]}"/>
                    <MenuItem Header="面" IsCheckable="True" IsChecked="{Binding EditsFaces}"
                              InputGestureText="{Binding Keys[EditFaces]}"/>
                </MenuItem>

                <MenuItem Header="形をいじる" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="押し出す"
                              Command="{Binding ExtrudeCommand}"
                              InputGestureText="{Binding Keys[Extrude]}"
                              ToolTip="選んでいる面をそのまま引き出します。押し出したあと、矢ハンドルで動かしてください。"/>

                    <MenuItem Header="面を張る"
                              Command="{Binding MakeFaceCommand}"
                              InputGestureText="{Binding Keys[MakeFace]}"
                              ToolTip="選んでいる 3〜8 点をつないで、新しい面を 1 枚作ります。"/>

                    <MenuItem Header="くっつける"
                              Command="{Binding MergeMeshCommand}"
                              InputGestureText="{Binding Keys[MergeMesh]}"
                              ToolTip="選んでいる頂点を、まん中の 1 点にまとめます。潰れた面は消えます。"/>

                    <MenuItem Header="消す"
                              Command="{Binding DeleteMeshCommand}"
                              InputGestureText="{Binding Keys[DeleteMesh]}"
                              ToolTip="選んでいる頂点と、それを使っている面を消します。"/>

                    <Separator/>

                    <MenuItem Header="ループカット"
                              Command="{Binding CutLoopCommand}"
                              InputGestureText="{Binding Keys[CutLoop]}"
                              ToolTip="選んでいる辺の並びに沿って、1周ぶんの切れ目を入れます。切れ目は辺の真ん中に入ります。"/>

                    <MenuItem Header="細かく分ける"
                              Command="{Binding SubdivideCommand}"
                              ToolTip="すべての面を、辺の真ん中と面のまん中で割ります。1 回ごとに面の数が角の数だけ増えます。"/>

                    <MenuItem Header="スライド"
                              IsCheckable="True"
                              IsChecked="{Binding SlidesMesh}"
                              InputGestureText="{Binding Keys[ToggleSlide]}"
                              ToolTip="入れている間、ドラッグすると選んだところが隣の辺に沿って滑ります。ループカットの位置をずらすときに使ってください。"/>
                </MenuItem>

                <MenuItem Header="選び方" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="つながりを選ぶ"
                              Command="{Binding SelectLinkedCommand}"
                              InputGestureText="{Binding Keys[SelectLinked]}"/>

                    <MenuItem Header="選択を反転"
                              Command="{Binding InvertSelectionCommand}"
                              InputGestureText="{Binding Keys[InvertSelection]}"/>

                    <MenuItem Header="広げる"
                              Command="{Binding GrowSelectionCommand}"
                              InputGestureText="{Binding Keys[GrowSelection]}"/>

                    <MenuItem Header="狭める"
                              Command="{Binding ShrinkSelectionCommand}"
                              InputGestureText="{Binding Keys[ShrinkSelection]}"/>
                </MenuItem>

                <MenuItem Header="メッシュの編集を捨てる"
                          Command="{Binding ResetMeshCommand}"
                          IsEnabled="{Binding CanEditMesh}"
                          ToolTip="編集した形を捨てて、選んでいる「形」のもとの姿に戻します。"/>

                <Separator/>

                <MenuItem Header="スナップ"
                          IsCheckable="True"
                          IsChecked="{Binding SnapsToGrid}"
                          InputGestureText="{Binding Keys[ToggleSnap]}"
                          ToolTip="入れると、ドラッグで動かした位置が決まった間隔に、回転が 15° ずつに吸い付きます。ドラッグ中に Shift を押している間は、入り切りが逆になります。"/>

                <MenuItem Header="スナップの間隔">
                    <MenuItem Header="10 px" IsCheckable="True" IsChecked="{Binding SnapsEvery10}"/>
                    <MenuItem Header="50 px" IsCheckable="True" IsChecked="{Binding SnapsEvery50}"/>
                    <MenuItem Header="100 px" IsCheckable="True" IsChecked="{Binding SnapsEvery100}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="視点">
                <MenuItem Header="平行投影"
                          IsCheckable="True"
                          IsChecked="{Binding IsOrthographic}"
                          InputGestureText="{Binding Keys[ToggleOrthographic]}"
                          ToolTip="遠近をつけずに写します。真横・真上から見て並べたり、床に接地させたりするときに使ってください。動画の出力には関係ありません。"/>

                <Separator/>

                <MenuItem Header="選んだものを注目"
                          Command="{Binding FocusSelectedCommand}"
                          InputGestureText="{Binding Keys[FocusSelected]}"
                          ToolTip="選んでいるアイテムが画面に収まるまで寄ります。以後の回り込みも、そのアイテムを中心に効きます。"/>

                <MenuItem Header="全体を見渡す"
                          Command="{Binding ViewAllCommand}"
                          InputGestureText="{Binding Keys[ViewAll]}"
                          ToolTip="いま出ているものが全部入るまで引きます。"/>

                <MenuItem Header="傾きを戻す"
                          Command="{Binding LevelRollCommand}"
                          InputGestureText="{Binding Keys[LevelRoll]}"
                          ToolTip="視点の傾きを 0 に戻します。位置と向きはそのままです。"/>

                <Separator/>

                <MenuItem Header="決まった向きから">
                    <MenuItem Header="前から" Command="{Binding ViewFromCommand}" CommandParameter="Front" InputGestureText="{Binding Keys[ViewFront]}"/>
                    <MenuItem Header="後ろから" Command="{Binding ViewFromCommand}" CommandParameter="Back" InputGestureText="{Binding Keys[ViewBack]}"/>
                    <MenuItem Header="右から" Command="{Binding ViewFromCommand}" CommandParameter="Right" InputGestureText="{Binding Keys[ViewRight]}"/>
                    <MenuItem Header="左から" Command="{Binding ViewFromCommand}" CommandParameter="Left" InputGestureText="{Binding Keys[ViewLeft]}"/>
                    <MenuItem Header="上から" Command="{Binding ViewFromCommand}" CommandParameter="Top" InputGestureText="{Binding Keys[ViewTop]}"/>
                    <MenuItem Header="下から" Command="{Binding ViewFromCommand}" CommandParameter="Bottom" InputGestureText="{Binding Keys[ViewBottom]}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                DataContext="{Binding Update}"
                Visibility="{Binding ShowsNotice, Converter={StaticResource VisibleWhenTrue}}"
                Background="#33FF9800"
                BorderBrush="#FF9800"
                BorderThickness="0,1"
                Padding="8,4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding DismissCommand}"
                        Content="×"
                        Padding="6,0"
                        Margin="6,0,0,0"
                        ToolTip="今回は表示しない"/>
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenDownloadPageCommand}"
                        Content="ダウンロードページを開く"
                        Padding="8,1"
                        Margin="8,0,0,0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="YMM43D の新しいバージョン"/>
                    <Run Text="{Binding LatestVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="が公開されています（今は"/>
                    <Run Text="{Binding CurrentVersion, Mode=OneWay}"/><Run Text="）"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF262626" Padding="6,8">
                <StackPanel VerticalAlignment="Top">
                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsSelectingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="選ぶ"/><LineBreak/>
                            <Run Text="ハンドルを出しません。クリックで選び、そのままドラッグで動かします。"/><LineBreak/>
                            <Run Text="Blender の「ツイーク」と同じです。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource SelectIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsMovingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="動かす"/><LineBreak/>
                            <Run Text="矢で1軸、矢の間の四角で2軸ぶん動かします。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource MoveIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsRotatingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="回す"/><LineBreak/>
                            <Run Text="輪をドラッグすると、その軸まわりに回ります。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource RotateIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsScalingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="大きさを変える"/><LineBreak/>
                            <Run Text="四角をドラッグすると拡大率が変わります。"/><LineBreak/>
                            <Run Text="YMM4 の拡大率は1つの値なので、どの軸を掴んでも同じだけ大きくなります。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource ScaleIcon}"/>
                </RadioButton>

                <Border Height="1" Background="#40FFFFFF" Margin="2,4,2,9"/>

                <ToggleButton Style="{StaticResource ModeToggle}"
                              IsChecked="{Binding IsEditingMesh, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditMesh}">
                    <ToggleButton.ToolTip>
                        <TextBlock>
                            <Run Text="編集モード"/><LineBreak/>
                            <Run Text="3Dアイテムを1つだけ選んでいるとき、その形そのものを編集します。"/><LineBreak/>
                            <Run Text="入れていないときは「オブジェクトモード」で、アイテムごと動かします。"/>
                        </TextBlock>
                    </ToggleButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource EditIcon}"/>
                </ToggleButton>

                <StackPanel Visibility="{Binding IsEditingMesh, Converter={StaticResource VisibleWhenTrue}}">
                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsVertices, Mode=TwoWay}"
                                 ToolTip="頂点で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource VertexIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsEdges, Mode=TwoWay}"
                                 ToolTip="辺で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource EdgeIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsFaces, Mode=TwoWay}"
                                 ToolTip="面で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource FaceIcon}"/>
                    </RadioButton>

                    <Border Height="1" Background="#40FFFFFF" Margin="2,5,2,9"/>

                    <RadioButton Style="{StaticResource ModeButton}"
                                 GroupName="GizmoMode"
                                 IsChecked="{Binding IsCuttingLoops, Mode=TwoWay}">
                        <RadioButton.ToolTip>
                            <TextBlock>
                                <Run Text="ループカット"/><LineBreak/>
                                <Run Text="切りたいところにカーソルを置くと、黄色い線で切れ目が出ます。"/><LineBreak/>
                                <Run Text="そこでクリックすると、1 周ぶんの切れ目が入ります。"/><LineBreak/>
                                <Run Text="続けて Shift+G を押すと、入れた切れ目を滑らせて位置を決められます。"/>
                            </TextBlock>
                        </RadioButton.ToolTip>
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource LoopCutIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ModeButton}"
                                 GroupName="GizmoMode"
                                 IsChecked="{Binding IsInflating, Mode=TwoWay}">
                        <RadioButton.ToolTip>
                            <TextBlock>
                                <Run Text="収縮／膨張"/><LineBreak/>
                                <Run Text="選んでいるところを、面の向きに沿って膨らませたり縮めたりします。"/><LineBreak/>
                                <Run Text="黄色い丸をドラッグしてください。外へ引くと膨らみ、内へ引くと縮みます。"/>
                            </TextBlock>
                        </RadioButton.ToolTip>
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource InflateIcon}"/>
                    </RadioButton>
                </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding D3DHost}"/>

            <Border Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="8,8,8,34"
                    Padding="6,2"
                    Background="#99000000"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasEditHint, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding EditHint}" Foreground="#FFB74D"/>
            </Border>

            <Border Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="8"
                    Padding="6,2"
                    Background="#99000000"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasSelectedBone, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding SelectedBoneName}" Foreground="#FFD54F"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
