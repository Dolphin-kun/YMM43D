<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <!--
        3D表示は HwndHost（子ウィンドウ）なので、WPF の要素を重ねても必ず下に隠れ、
        その範囲のクリックも子ウィンドウが持っていく。操作は重ねずに行を分ける。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 背景は塗らずに、置かれている場所の色をそのまま使う -->
        <Menu Grid.Row="0" Background="Transparent" Margin="0" Padding="0">
            <MenuItem Header="カメラ">
                <MenuItem Header="カメラを追加"
                          Command="{Binding AddCameraCommand}"
                          IsEnabled="{Binding CanAddCamera}"
                          ToolTip="いまの再生位置に「3Dカメラ」アイテムを置きます。空いているレイヤーを下から探します。"/>

                <Separator/>

                <MenuItem Header="カメラ追従"
                          IsCheckable="True"
                          IsChecked="{Binding DrivesSceneCamera}"
                          InputGestureText="テンキー0"
                          ToolTip="入れると、見る位置がカメラアイテムに追従し、ドラッグがそのカメラを直接動かします。外すと見る位置だけが動き、出力は変わりません。"/>

                <MenuItem Header="視点をカメラに戻す"
                          Command="{Binding ResetToSceneCameraCommand}"
                          InputGestureText="Ctrl+R"
                          ToolTip="プレビューで見る位置を、いまシーンを撮っているカメラの位置に合わせ直します。"/>
            </MenuItem>

            <MenuItem Header="視点">
                <MenuItem Header="選んだものを注視"
                          Command="{Binding FocusSelectedCommand}"
                          InputGestureText="F"
                          ToolTip="選んでいるアイテムが画面に収まるまで寄ります。以後の回り込みも、そのアイテムを中心に効きます。"/>

                <MenuItem Header="全体を見渡す"
                          Command="{Binding ViewAllCommand}"
                          InputGestureText="Home"
                          ToolTip="いま出ているものが全部入るまで引きます。"/>

                <MenuItem Header="傾きを戻す"
                          Command="{Binding LevelRollCommand}"
                          InputGestureText="Shift+R"
                          ToolTip="視点の傾きを 0 に戻します。位置と向きはそのままです。"/>

                <Separator/>

                <MenuItem Header="決まった向きから">
                    <MenuItem Header="前から" Command="{Binding ViewFromCommand}" CommandParameter="Front" InputGestureText="テンキー1"/>
                    <MenuItem Header="後ろから" Command="{Binding ViewFromCommand}" CommandParameter="Back" InputGestureText="Ctrl+テンキー1"/>
                    <MenuItem Header="右から" Command="{Binding ViewFromCommand}" CommandParameter="Right" InputGestureText="テンキー3"/>
                    <MenuItem Header="左から" Command="{Binding ViewFromCommand}" CommandParameter="Left" InputGestureText="Ctrl+テンキー3"/>
                    <MenuItem Header="上から" Command="{Binding ViewFromCommand}" CommandParameter="Top" InputGestureText="テンキー7"/>
                    <MenuItem Header="下から" Command="{Binding ViewFromCommand}" CommandParameter="Bottom" InputGestureText="Ctrl+テンキー7"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 3D表示 -->
        <ContentControl Grid.Row="1" Content="{Binding D3DHost}"/>
    </Grid>
</UserControl>
