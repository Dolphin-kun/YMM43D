<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             xmlns:commons="clr-namespace:YMM43D.Commons"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/YMM43D;component/PreviewTool/Views/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>

        <SolidColorBrush x:Key="ModeInk" Color="#FFECECEC"/>

        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource ModeInk}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>

        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Back"
                                     Fill="#B2202020"
                                     Stroke="#40FFFFFF"
                                     StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Stroke" Value="#C0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Fill" Value="#CCF57C00"/>
                                <Setter TargetName="Back" Property="Stroke" Value="#FFFFCC80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Back"
                                     Fill="#B2202020"
                                     Stroke="#40FFFFFF"
                                     StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Stroke" Value="#C0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Fill" Value="#CC1E88E5"/>
                                <Setter TargetName="Back" Property="Stroke" Value="#FF90CAF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeshEntry" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Parameter}"/>
            <Setter Property="InputGestureText" Value="{Binding Gesture}"/>
            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Separator/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0,0,4"/>
        </Style>

        <Style x:Key="SideLabel" TargetType="Label">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <ContextMenu x:Key="MeshPopup" ItemContainerStyle="{StaticResource MeshEntry}"/>

        <Style x:Key="PartButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3,0,3,4"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
              Margin="0"
              Padding="0"
              Focusable="False"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              KeyboardNavigation.ControlTabNavigation="None"
              KeyboardNavigation.DirectionalNavigation="None">
            <MenuItem Header="追加">
                <MenuItem Header="3Dカメラ"
                          Command="{Binding AddCameraCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3Dカメラ」アイテムを置きます。レイヤー番号がいちばん大きいものが使われます。"/>

                <MenuItem Header="3D光源"
                          Command="{Binding AddLightCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3D光源」アイテムを置きます。置いた分だけ足し合わさります。1つも置かなければ、決まった光が当たります。"/>

                <MenuItem Header="3D環境"
                          Command="{Binding AddEnvironmentCommand}"
                          IsEnabled="{Binding CanAddItem}"
                          ToolTip="いまの再生位置に「3D環境」アイテムを置きます。環境光と霧を決めます。レイヤー番号がいちばん大きいものが使われます。"/>
            </MenuItem>

            <MenuItem Header="カメラ">
                <MenuItem Header="カメラ追従"
                          IsCheckable="True"
                          IsChecked="{Binding DrivesSceneCamera}"
                          InputGestureText="{Binding Keys[DriveSceneCamera]}"
                          ToolTip="入れると、見る位置がカメラアイテムに追従し、ドラッグがそのカメラを直接動かします。外すと見る位置だけが動き、出力は変わりません。入れている間はドラッグでアイテムを掴めません。動かすときは、選んでから軸ハンドルを掴んでください。"/>

                <MenuItem Header="ドラッグで中間点を打つ"
                          IsCheckable="True"
                          IsChecked="{Binding InsertsKeyFrame}"
                          InputGestureText="{Binding Keys[ToggleAutoKeyFrame]}"
                          ToolTip="入れると、ドラッグがいまの再生位置に中間点を打ち、そこだけを動かします。外すと、打ってある中間点すべてが同じだけ動きます。カメラにもアイテムにも効きます。"/>

                <MenuItem Header="現在の再生位置に中間点を追加"
                          Command="{Binding AddKeyFrameCommand}"
                          IsEnabled="{Binding HasSelectedItem}"
                          InputGestureText="{Binding Keys[AddKeyFrame]}"
                          ToolTip="YMM4 本体の「現在の再生位置に中間点を追加」を、選んでいるアイテムに対して実行します。アイテムを選んでいないときは押せません。"/>

                <MenuItem Header="視点をカメラに戻す"
                          Command="{Binding ResetToSceneCameraCommand}"
                          InputGestureText="{Binding Keys[ViewCamera]}"
                          ToolTip="プレビューで見る位置を、いまシーンを撮っているカメラの位置に合わせ直します。"/>
            </MenuItem>

            <MenuItem Header="表示">
                <MenuItem Header="グリッド"
                          IsCheckable="True"
                          IsChecked="{Binding ShowsGrid}"
                          InputGestureText="{Binding Keys[ToggleGrid]}"
                          ToolTip="床の格子と、原点を通る2本の座標軸を出すかどうか。動画の出力には関係ありません。"/>

                <MenuItem Header="サイドバー"
                          IsCheckable="True"
                          IsChecked="{Binding IsSidebarOpen}"
                          InputGestureText="{Binding Keys[ToggleSidebar]}"
                          ToolTip="プレビューの右に、選んだところの位置・3Dカーソル・材質・シェイプキー・直前の操作のやり直しなどを出す欄を開きます。右端の「＜」を押しても開け閉めできます。"/>

                <MenuItem Header="モデルを網で出す"
                          IsCheckable="True"
                          IsChecked="{Binding ShowsMesh}"
                          InputGestureText="{Binding Keys[ToggleWireframe]}"
                          ToolTip="3Dモデルを面で塗らず、線だけ（網）で出します。体の中のボーンが見えるので、ボーンを掴みやすくなります。動画の出力には関係ありません。"/>

                <MenuItem Header="UV エディタ"
                          IsCheckable="True"
                          IsChecked="{Binding IsUvView}"
                          IsEnabled="{Binding IsEditingMesh}"
                          InputGestureText="{Binding Keys[ToggleUvView]}"
                          ToolTip="編集モードのあいだ、3D の代わりに UV（面に画像を貼る位置）を平らに広げて出します。選び方は 3D と同じで、G・R・S で UV を動かせます。"/>
            </MenuItem>

            <MenuItem Header="編集">
                <MenuItem Header="すべて選ぶ"
                          Command="{Binding SelectAllCommand}"
                          InputGestureText="{Binding Keys[SelectAll]}"
                          ToolTip="3Dプレビューに出ているアイテムをすべて選びます。Ctrl を押しながらクリックすると、1つずつ足したり外したりできます。選んだものはまとめて動かせます。"/>

                <MenuItem Header="選択を解除"
                          Command="{Binding ClearSelectionCommand}"
                          InputGestureText="{Binding Keys[ClearSelection]}"/>

                <Separator/>

                <MenuItem Header="書き出す">
                    <MenuItem Header="OBJ（.obj ＋ .mtl）…"
                              Command="{Binding ExportObjCommand}"
                              ToolTip="選んでいる 3Dアイテムの形を、モディファイアとシェイプキーを今の時点の値で掛けた形で書き出します。材質の画像は書き出し先へ写します。"/>
                    <MenuItem Header="glTF バイナリ（.glb）…"
                              Command="{Binding ExportGlbCommand}"
                              ToolTip="選んでいる 3Dアイテムの形を、材質と画像ごと 1 つのファイルに書き出します。Blender などで読めます。"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="ローカル軸で動かす"
                          IsCheckable="True"
                          IsChecked="{Binding UsesLocalSpace}"
                          InputGestureText="{Binding Keys[ToggleLocalSpace]}"
                          ToolTip="入れると、軸ハンドルと回転の輪がそのアイテムの向きに沿います。外すと世界の軸に沿います。回したものを「その正面へ出す」ときに使ってください。"/>

                <Separator/>

                <MenuItem Header="編集モード"
                          IsCheckable="True"
                          IsChecked="{Binding IsEditingMesh}"
                          IsEnabled="{Binding CanEditMesh}"
                          InputGestureText="{Binding Keys[ToggleEditMode]}"
                          ToolTip="3Dアイテムを1つだけ選んでいるとき、その形そのものを編集します。頂点をドラッグすると形が変わります。"/>

                <MenuItem Header="選んだアイテムをくっつける"
                          Command="{Binding JoinCommand}"
                          IsEnabled="{Binding HasSelectedItem}"
                          InputGestureText="{Binding Keys[Join]}"
                          ToolTip="選んでいる 3D アイテムの形を、最初に選んだアイテムへまとめて 1 つにします。ほかのアイテムは消えます。面の色は最初のアイテムのものになります。"/>

                <MenuItem Header="選ぶ単位" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="頂点" IsCheckable="True" IsChecked="{Binding EditsVertices}"
                              InputGestureText="{Binding Keys[EditVertices]}"/>
                    <MenuItem Header="辺" IsCheckable="True" IsChecked="{Binding EditsEdges}"
                              InputGestureText="{Binding Keys[EditEdges]}"/>
                    <MenuItem Header="面" IsCheckable="True" IsChecked="{Binding EditsFaces}"
                              InputGestureText="{Binding Keys[EditFaces]}"/>
                </MenuItem>

                <MenuItem Header="形をいじる" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="押し出す"
                              Command="{Binding ExtrudeCommand}"
                              InputGestureText="{Binding Keys[Extrude]}"
                              ToolTip="選んでいる面・辺・頂点を引き出し、そのまま動かします。面は面の向きへ動きます。クリックか Enter で決め、右クリックか Esc で押し出しだけを残して止めます。"/>

                    <MenuItem Header="差し込む"
                              Command="{Binding InsetCommand}"
                              InputGestureText="{Binding Keys[Inset]}"
                              ToolTip="選んでいる面の内側に、一回り小さい面を作ります。マウスを中心から離すほど幅が広がり、数字を打つと px で決まります。"/>

                    <MenuItem Header="角を削る（ベベル）"
                              Command="{Binding BevelCommand}"
                              InputGestureText="{Binding Keys[Bevel]}"
                              ToolTip="選んでいる面を少し縮めて、辺と角に面を足します。マウスを中心から離すほど大きく削れ、数字を打つと px で決まります。"/>

                    <MenuItem Header="厚みを付ける"
                              Command="{Binding SolidifyCommand}"
                              ToolTip="ぺらい面の裏に、もう一枚ぶんの面と側面を足して中身のある形にします。厚みはマウスの距離か数字（px、- で内側）で決めます。何も選んでいなければ全体に掛かります。"/>

                    <MenuItem Header="ミラーを足す"
                              Command="{Binding MirrorCommand}"
                              ToolTip="X が 0 のところを境にして左右に写すモディファイアを足します。片側だけ作れば、反対側は自動で付いてきます。設定はアイテムの「モディファイア」欄で変えます。"/>

                    <Separator/>

                    <MenuItem Header="押し出しの種類"
                              ItemsSource="{Binding MeshMenus[Extrude]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[ExtrudeMenu]}"/>

                    <MenuItem Header="消す"
                              ItemsSource="{Binding MeshMenus[Delete]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[DeleteMenu]}"/>

                    <MenuItem Header="くっつける"
                              ItemsSource="{Binding MeshMenus[Merge]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[MergeMenu]}"/>

                    <MenuItem Header="頂点"
                              ItemsSource="{Binding MeshMenus[Vertex]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[VertexMenu]}"/>

                    <MenuItem Header="辺"
                              ItemsSource="{Binding MeshMenus[Edge]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[EdgeMenu]}"/>

                    <MenuItem Header="面"
                              ItemsSource="{Binding MeshMenus[Face]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[FaceMenu]}"/>

                    <MenuItem Header="面の向き"
                              ItemsSource="{Binding MeshMenus[Normal]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[NormalMenu]}"/>

                    <MenuItem Header="UV"
                              ItemsSource="{Binding MeshMenus[Uv]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[UvMenu]}"/>

                    <MenuItem Header="形を足す"
                              ItemsSource="{Binding MeshMenus[Add]}"
                              ItemContainerStyle="{StaticResource MeshEntry}"
                              InputGestureText="{Binding Keys[AddMenu]}"/>

                    <Separator/>

                    <MenuItem Header="切る">
                        <MenuItem Header="ナイフ"
                                  Command="{Binding MeshCommand}"
                                  CommandParameter="Knife"
                                  InputGestureText="{Binding Keys[Knife]}"
                                  ToolTip="クリックで点を打って線を引き、その線に沿って面を切ります。頂点や辺の近くをクリックするとそこに吸い付きます。Enter で切り、Esc でやめます。"/>

                        <MenuItem Header="二等分"
                                  Command="{Binding MeshCommand}"
                                  CommandParameter="Bisect"
                                  ToolTip="ドラッグで引いた線を画面の奥へ伸ばした平面で、選んだ面（選んでいなければ全体）を切ります。"/>

                        <MenuItem Header="二等分して片側を消す"
                                  Command="{Binding MeshCommand}"
                                  CommandParameter="BisectClear"
                                  ToolTip="二等分したあと、引いた線の左側を消します。右側が残ります。"/>

                        <MenuItem Header="二等分して片側を消し、ふたをする"
                                  Command="{Binding MeshCommand}"
                                  CommandParameter="BisectFill"
                                  ToolTip="二等分して線の左側を消し、切り口に面を張ってふさぎます。"/>
                    </MenuItem>

                    <MenuItem Header="複製"
                              Command="{Binding MeshCommand}"
                              CommandParameter="Duplicate"
                              InputGestureText="{Binding Keys[Duplicate]}"
                              ToolTip="選んだところを写し、そのまま動かします。右クリックか Esc で止めると元の場所に重なったまま残ります。"/>

                    <MenuItem Header="別のアイテムに分ける"
                              Command="{Binding MeshCommand}"
                              CommandParameter="Separate"
                              InputGestureText="{Binding Keys[Separate]}"
                              ToolTip="選んだところを切り取り、同じ設定の新しい 3D アイテムにします。"/>

                    <Separator/>

                    <MenuItem Header="スライド"
                              IsCheckable="True"
                              IsChecked="{Binding SlidesMesh}"
                              InputGestureText="{Binding Keys[ToggleSlide]}"
                              ToolTip="入れている間、ドラッグすると選んだところが隣の辺に沿って滑ります。ループカットの位置をずらすときに使ってください。"/>
                </MenuItem>

                <MenuItem Header="選び方" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="つながりを選ぶ"
                              Command="{Binding SelectLinkedCommand}"
                              InputGestureText="{Binding Keys[SelectLinked]}"/>

                    <MenuItem Header="選択を反転"
                              Command="{Binding InvertSelectionCommand}"
                              InputGestureText="{Binding Keys[InvertSelection]}"/>

                    <MenuItem Header="広げる"
                              Command="{Binding GrowSelectionCommand}"
                              InputGestureText="{Binding Keys[GrowSelection]}"/>

                    <MenuItem Header="狭める"
                              Command="{Binding ShrinkSelectionCommand}"
                              InputGestureText="{Binding Keys[ShrinkSelection]}"/>

                    <Separator/>

                    <MenuItem Header="範囲で選ぶ"
                              Command="{Binding BoxSelectCommand}"
                              InputGestureText="{Binding Keys[BoxSelect]}"
                              ToolTip="次のドラッグで囲んだところを選びます。Shift で足し、Ctrl で外します。左の「選択」の道具のときは、いつでもドラッグで選べます。"/>

                    <MenuItem Header="選択の道具で囲む形" InputGestureText="{Binding Keys[CycleSelectShape]}">
                        <MenuItem Header="四角" IsCheckable="True" IsChecked="{Binding SelectsByBox}"/>
                        <MenuItem Header="投げ縄" IsCheckable="True" IsChecked="{Binding SelectsByLasso}"/>
                        <MenuItem Header="円（なぞって塗る）" IsCheckable="True" IsChecked="{Binding SelectsByCircle}"
                                  ToolTip="なぞったところを足していきます。Ctrl で外します。ドラッグ中のホイールで円の大きさを変えます。"/>
                    </MenuItem>

                    <MenuItem Header="透かして選ぶ（X線）"
                              IsCheckable="True"
                              IsChecked="{Binding IsXRay}"
                              InputGestureText="{Binding Keys[ToggleXRay]}"
                              ToolTip="入れると形が半透明になり、裏に隠れた頂点・辺・面もクリックや範囲で選べます。切ると、見えているものだけを選びます。"/>

                    <Separator/>

                    <MenuItem Header="選んだところを隠す"
                              Command="{Binding HideCommand}"
                              InputGestureText="{Binding Keys[HideSelected]}"
                              ToolTip="編集モードの間だけ、選んでいるところを見えなくして選べなくします。動画には影響しません。"/>

                    <MenuItem Header="選んでいないところを隠す"
                              Command="{Binding HideOthersCommand}"
                              InputGestureText="{Binding Keys[HideOthers]}"/>

                    <MenuItem Header="隠したところを戻す"
                              Command="{Binding RevealCommand}"
                              InputGestureText="{Binding Keys[RevealHidden]}"
                              ToolTip="隠していたところをすべて戻し、戻したところを選びます。"/>
                </MenuItem>

                <MenuItem Header="動かし方" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="回転・拡大の中心" InputGestureText="{Binding Keys[CyclePivot]}">
                        <MenuItem Header="選んだところの中心" IsCheckable="True" IsChecked="{Binding PivotsAtMedian}"/>
                        <MenuItem Header="選んだ範囲の中心" IsCheckable="True" IsChecked="{Binding PivotsAtBounds}"/>
                        <MenuItem Header="3Dカーソル" IsCheckable="True" IsChecked="{Binding PivotsAtCursor}"/>
                        <MenuItem Header="それぞれのまとまりの中心" IsCheckable="True" IsChecked="{Binding PivotsIndividually}"
                                  ToolTip="つながっていない部分ごとに、その中心で回したり大きさを変えたりします。"/>
                        <MenuItem Header="最後に選んだところ" IsCheckable="True" IsChecked="{Binding PivotsAtActive}"/>
                    </MenuItem>

                    <MenuItem Header="3Dカーソル"
                              ToolTip="Shift を押しながら右クリックで、形の表面に置けます。">
                        <MenuItem Header="カーソルを選んだところへ"
                                  Command="{Binding CursorToSelectedCommand}"
                                  InputGestureText="{Binding Keys[CursorToSelected]}"/>
                        <MenuItem Header="カーソルを原点へ"
                                  Command="{Binding CursorToOriginCommand}"
                                  InputGestureText="{Binding Keys[CursorToOrigin]}"/>
                        <MenuItem Header="選んだところをカーソルへ"
                                  Command="{Binding SelectionToCursorCommand}"/>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="プロポーショナル編集"
                              IsCheckable="True"
                              IsChecked="{Binding IsProportional}"
                              InputGestureText="{Binding Keys[ToggleProportional]}"
                              ToolTip="選んだところの周りも、近いほど強く一緒に動きます。動かしている間のホイールか PageUp / PageDown で、効く範囲を変えます。"/>

                    <MenuItem Header="つながっているところだけ"
                              IsCheckable="True"
                              IsChecked="{Binding ConnectsProportional}"
                              InputGestureText="{Binding Keys[ToggleConnected]}"
                              ToolTip="空間の距離ではなく、辺をたどった距離で効き方を決めます。近くにあっても離れた部分は動きません。"/>

                    <MenuItem Header="効き方の減り方" InputGestureText="{Binding Keys[CycleFalloff]}">
                        <MenuItem Header="なめらか" IsCheckable="True" IsChecked="{Binding FallsSmooth}"/>
                        <MenuItem Header="球" IsCheckable="True" IsChecked="{Binding FallsSphere}"/>
                        <MenuItem Header="ルート" IsCheckable="True" IsChecked="{Binding FallsRoot}"/>
                        <MenuItem Header="逆二乗" IsCheckable="True" IsChecked="{Binding FallsInverseSquare}"/>
                        <MenuItem Header="鋭い" IsCheckable="True" IsChecked="{Binding FallsSharp}"/>
                        <MenuItem Header="直線" IsCheckable="True" IsChecked="{Binding FallsLinear}"/>
                        <MenuItem Header="一定" IsCheckable="True" IsChecked="{Binding FallsConstant}"/>
                        <MenuItem Header="ランダム" IsCheckable="True" IsChecked="{Binding FallsRandom}"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="メッシュの編集を捨てる"
                          Command="{Binding ResetMeshCommand}"
                          IsEnabled="{Binding CanEditMesh}"
                          ToolTip="編集した形を捨てて、選んでいる「形」のもとの姿に戻します。"/>

                <Separator/>

                <MenuItem Header="スナップ"
                          IsCheckable="True"
                          IsChecked="{Binding SnapsToGrid}"
                          InputGestureText="{Binding Keys[ToggleSnap]}"
                          ToolTip="入れると、動かした位置が「スナップ先」に吸い付きます。動かしている間に Shift を押している間は、入り切りが逆になります。"/>

                <MenuItem Header="スナップの間隔">
                    <MenuItem Header="10 px" IsCheckable="True" IsChecked="{Binding SnapsEvery10}"/>
                    <MenuItem Header="50 px" IsCheckable="True" IsChecked="{Binding SnapsEvery50}"/>
                    <MenuItem Header="100 px" IsCheckable="True" IsChecked="{Binding SnapsEvery100}"/>
                </MenuItem>

                <MenuItem Header="スナップ先" IsEnabled="{Binding IsEditingMesh}">
                    <MenuItem Header="グリッドの間隔" IsCheckable="True" IsChecked="{Binding SnapsToIncrement}"
                              ToolTip="動かす量を「スナップの間隔」ずつ、回転を 15° ずつ、大きさを 0.1 倍ずつにします。"/>
                    <MenuItem Header="頂点" IsCheckable="True" IsChecked="{Binding SnapsToVertex}"/>
                    <MenuItem Header="辺" IsCheckable="True" IsChecked="{Binding SnapsToEdge}"/>
                    <MenuItem Header="面" IsCheckable="True" IsChecked="{Binding SnapsToFace}"/>
                </MenuItem>

                <MenuItem Header="スナップの基準" IsEnabled="{Binding IsEditingMesh}"
                          ToolTip="頂点・辺・面に吸い付けるとき、選んだところのどこを合わせるかです。">
                    <MenuItem Header="選んだところの中心" IsCheckable="True" IsChecked="{Binding SnapsFromCenter}"/>
                    <MenuItem Header="いちばん近い頂点" IsCheckable="True" IsChecked="{Binding SnapsFromClosest}"/>
                    <MenuItem Header="最後に選んだところ" IsCheckable="True" IsChecked="{Binding SnapsFromActive}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="視点">
                <MenuItem Header="平行投影"
                          IsCheckable="True"
                          IsChecked="{Binding IsOrthographic}"
                          InputGestureText="{Binding Keys[ToggleOrthographic]}"
                          ToolTip="遠近をつけずに写します。真横・真上から見て並べたり、床に接地させたりするときに使ってください。動画の出力には関係ありません。"/>

                <Separator/>

                <MenuItem Header="選んだものを注目"
                          Command="{Binding FocusSelectedCommand}"
                          InputGestureText="{Binding Keys[FocusSelected]}"
                          ToolTip="選んでいるアイテムが画面に収まるまで寄ります。以後の回り込みも、そのアイテムを中心に効きます。"/>

                <MenuItem Header="全体を見渡す"
                          Command="{Binding ViewAllCommand}"
                          InputGestureText="{Binding Keys[ViewAll]}"
                          ToolTip="いま出ているものが全部入るまで引きます。"/>

                <MenuItem Header="傾きを戻す"
                          Command="{Binding LevelRollCommand}"
                          InputGestureText="{Binding Keys[LevelRoll]}"
                          ToolTip="視点の傾きを 0 に戻します。位置と向きはそのままです。"/>

                <Separator/>

                <MenuItem Header="決まった向きから">
                    <MenuItem Header="前から" Command="{Binding ViewFromCommand}" CommandParameter="Front" InputGestureText="{Binding Keys[ViewFront]}"/>
                    <MenuItem Header="後ろから" Command="{Binding ViewFromCommand}" CommandParameter="Back" InputGestureText="{Binding Keys[ViewBack]}"/>
                    <MenuItem Header="右から" Command="{Binding ViewFromCommand}" CommandParameter="Right" InputGestureText="{Binding Keys[ViewRight]}"/>
                    <MenuItem Header="左から" Command="{Binding ViewFromCommand}" CommandParameter="Left" InputGestureText="{Binding Keys[ViewLeft]}"/>
                    <MenuItem Header="上から" Command="{Binding ViewFromCommand}" CommandParameter="Top" InputGestureText="{Binding Keys[ViewTop]}"/>
                    <MenuItem Header="下から" Command="{Binding ViewFromCommand}" CommandParameter="Bottom" InputGestureText="{Binding Keys[ViewBottom]}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                DataContext="{x:Static commons:UpdateChecker.Instance}"
                Visibility="{Binding ShowsNotice, Converter={StaticResource VisibleWhenTrue}}"
                Background="#33FF9800"
                BorderBrush="#FF9800"
                BorderThickness="0,1"
                Padding="8,4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding DismissCommand}"
                        Content="×"
                        Padding="6,0"
                        Margin="6,0,0,0"
                        ToolTip="今回は表示しない"/>
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenDownloadPageCommand}"
                        Content="ダウンロードページを開く"
                        Padding="8,1"
                        Margin="8,0,0,0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="YMM43D の新しいバージョン"/>
                    <Run Text="{Binding LatestVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="が公開されています（現在"/>
                    <Run Text="{x:Static commons:UpdateChecker.CurrentVersion}"/><Run Text="）"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Background="#FF262626">
            <Border Padding="6,8">
                <StackPanel VerticalAlignment="Top">
                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsSelectingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="選ぶ"/><LineBreak/>
                            <Run Text="ハンドルを出しません。クリックで選び、そのままドラッグで動かします。"/><LineBreak/>
                            <Run Text="Blender の「ツイーク」と同じです。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource SelectIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsMovingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="動かす"/><LineBreak/>
                            <Run Text="矢で1軸、矢の間の四角で2軸ぶん動かします。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource MoveIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsRotatingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="回す"/><LineBreak/>
                            <Run Text="輪をドラッグすると、その軸まわりに回ります。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource RotateIcon}"/>
                </RadioButton>

                <RadioButton Style="{StaticResource ModeButton}"
                             GroupName="GizmoMode"
                             IsChecked="{Binding IsScalingMode, Mode=TwoWay}">
                    <RadioButton.ToolTip>
                        <TextBlock>
                            <Run Text="大きさを変える"/><LineBreak/>
                            <Run Text="四角をドラッグすると拡大率が変わります。"/><LineBreak/>
                            <Run Text="YMM4 の拡大率は1つの値なので、どの軸を掴んでも同じだけ大きくなります。"/>
                        </TextBlock>
                    </RadioButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource ScaleIcon}"/>
                </RadioButton>

                <Border Height="1" Background="#40FFFFFF" Margin="2,4,2,9"/>

                <ToggleButton Style="{StaticResource ModeToggle}"
                              IsChecked="{Binding IsEditingMesh, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditMesh}">
                    <ToggleButton.ToolTip>
                        <TextBlock>
                            <Run Text="編集モード"/><LineBreak/>
                            <Run Text="3Dアイテムを1つだけ選んでいるとき、その形そのものを編集します。"/><LineBreak/>
                            <Run Text="入れていないときは「オブジェクトモード」で、アイテムごと動かします。"/>
                        </TextBlock>
                    </ToggleButton.ToolTip>
                    <Path Style="{StaticResource ModeIcon}" Data="{StaticResource EditIcon}"/>
                </ToggleButton>

                <StackPanel Visibility="{Binding IsEditingMesh, Converter={StaticResource VisibleWhenTrue}}">
                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsVertices, Mode=TwoWay}"
                                 ToolTip="頂点で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource VertexIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsEdges, Mode=TwoWay}"
                                 ToolTip="辺で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource EdgeIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource PartButton}"
                                 GroupName="MeshPart"
                                 IsChecked="{Binding EditsFaces, Mode=TwoWay}"
                                 ToolTip="面で選ぶ">
                        <Path Style="{StaticResource ModeIcon}" Width="12" Height="12"
                              Data="{StaticResource FaceIcon}"/>
                    </RadioButton>

                    <Border Height="1" Background="#40FFFFFF" Margin="2,5,2,9"/>

                    <RadioButton Style="{StaticResource ModeButton}"
                                 GroupName="GizmoMode"
                                 IsChecked="{Binding IsCuttingLoops, Mode=TwoWay}">
                        <RadioButton.ToolTip>
                            <TextBlock>
                                <Run Text="ループカット"/><LineBreak/>
                                <Run Text="切りたいところにカーソルを置くと、黄色い線で切れ目が出ます。"/><LineBreak/>
                                <Run Text="そこでクリックすると、1 周ぶんの切れ目が入ります。"/><LineBreak/>
                                <Run Text="続けて Shift+G を押すと、入れた切れ目を滑らせて位置を決められます。"/>
                            </TextBlock>
                        </RadioButton.ToolTip>
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource LoopCutIcon}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ModeButton}"
                                 GroupName="GizmoMode"
                                 IsChecked="{Binding IsInflating, Mode=TwoWay}">
                        <RadioButton.ToolTip>
                            <TextBlock>
                                <Run Text="収縮／膨張"/><LineBreak/>
                                <Run Text="選んでいるところを、面の向きに沿って膨らませたり縮めたりします。"/><LineBreak/>
                                <Run Text="黄色い丸をドラッグしてください。外へ引くと膨らみ、内へ引くと縮みます。"/>
                            </TextBlock>
                        </RadioButton.ToolTip>
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource InflateIcon}"/>
                    </RadioButton>
                </StackPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <ContentControl Grid.Column="1" Content="{Binding D3DHost}"/>

            <DockPanel Grid.Column="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <Thumb DockPanel.Dock="Left" Width="6" Cursor="SizeWE" DragDelta="SidebarEdge_DragDelta" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <Border x:Name="SidebarFrame" ClipToBounds="True" Width="0">
                <ScrollViewer Width="{Binding SidebarWidth}"
                              HorizontalAlignment="Left"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel DataContext="{Binding Sidebar}" Margin="4,8,8,8">
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Visibility="{Binding HasRedo, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                            <StackPanel DataContext="{Binding Redo}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SideHeader}" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,2" Visibility="{Binding HasAmount, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding AmountLabel}" Style="{StaticResource SideLabel}"/>
                                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Amount, Mode=TwoWay}" Unit="{Binding AmountUnitText, Mode=OneWay}" StringFormat="{Binding AmountFormat, Mode=OneWay}" Delta="{Binding AmountDelta, Mode=OneWay}" Min="{Binding AmountMin, Mode=OneWay}" Max="{Binding AmountMax, Mode=OneWay}" DefaultMin="{Binding AmountDefaultMin, Mode=OneWay}" DefaultMax="{Binding AmountDefaultMax, Mode=OneWay}" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                                </Grid>

                                <Grid Margin="0,0,0,2" Visibility="{Binding HasCount, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding CountLabel}" Style="{StaticResource SideLabel}"/>
                                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Count, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="{Binding CountMin, Mode=OneWay}" Max="200" DefaultMin="{Binding CountMin, Mode=OneWay}" DefaultMax="20" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                                </Grid>

                                <Grid Margin="0,0,0,2" Visibility="{Binding HasShift, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding ShiftLabel}" Style="{StaticResource SideLabel}"/>
                                    <c:TextBoxSlider Grid.Column="1" Value="{Binding Shift, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F0" Delta="1" Min="-200" Max="200" DefaultMin="-20" DefaultMax="20" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                                </Grid>
                            </StackPanel>
                            </StackPanel>

                            <TextBlock Text="メッシュ" Style="{StaticResource SideHeader}"/>

                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="X" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CenterX, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Y" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CenterY, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Z" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CenterZ, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsProportional, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                                <TextBlock Text="プロポーショナル編集" Style="{StaticResource SideHeader}"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="範囲" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding Radius, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="1" Max="100000" DefaultMin="1" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasHidden, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                                <TextBlock Text="隠しているもの" Style="{StaticResource SideHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HiddenText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Button Grid.Column="1" Content="すべて表示" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsUv, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                                <TextBlock Text="UV" Style="{StaticResource SideHeader}"/>
                                <StackPanel Visibility="{Binding HasUvSelection, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="U" Style="{StaticResource SideLabel}"/>
                                        <c:TextBoxSlider Grid.Column="1" Value="{Binding UvU, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F3" Delta="0.001" Min="-100" Max="100" DefaultMin="0" DefaultMax="1" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="V" Style="{StaticResource SideLabel}"/>
                                        <c:TextBoxSlider Grid.Column="1" Value="{Binding UvV, Mode=TwoWay}" Unit="" IsUnitVisible="False" StringFormat="F3" Delta="0.001" Min="-100" Max="100" DefaultMin="0" DefaultMax="1" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                                    </Grid>
                                </StackPanel>
                                <UniformGrid Columns="2">
                                    <Button Content="展開" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Unwrap"/>
                                    <Button Content="スマート UV 投影" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="SmartProject"/>
                                    <Button Content="立方体で投影" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="CubeProject"/>
                                    <Button Content="円柱で投影" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="CylinderProject"/>
                                    <Button Content="球で投影" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="SphereProject"/>
                                    <Button Content="ビューから投影" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="ViewProject"/>
                                    <Button Content="リセット" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="ResetUvs"/>
                                    <Button Content="島を並べる" Command="{Binding DataContext.MeshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="PackIslands"/>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasShapeKeys, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                                <TextBlock Text="シェイプキー" Style="{StaticResource SideHeader}"/>
                                <ComboBox ItemsSource="{Binding ShapeKeys}" SelectedIndex="{Binding ShapeKeyIndex}" ToolTip="編集する形。「基準」以外を選ぶと、動かした量がそのキーの形として覚えられます"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasMaterials, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                                <TextBlock Text="材質" Style="{StaticResource SideHeader}"/>
                                <ComboBox Margin="0,0,0,2" ItemsSource="{Binding Materials}" SelectedIndex="{Binding MaterialIndex}"/>
                                <UniformGrid Columns="3">
                                    <Button Content="割り当て" ToolTip="選んだ面をこの材質で塗ります" Command="{Binding AssignMaterialCommand}"/>
                                    <Button Content="選ぶ" ToolTip="この材質の面を選びます" Command="{Binding SelectMaterialCommand}"/>
                                    <Button Content="外す" ToolTip="この材質の面を選びから外します" Command="{Binding DeselectMaterialCommand}"/>
                                </UniformGrid>
                            </StackPanel>

                        <TextBlock Text="3Dカーソル" Style="{StaticResource SideHeader}"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="X" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CursorX, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Y" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CursorY, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Z" Style="{StaticResource SideLabel}"/>
                            <c:TextBoxSlider Grid.Column="1" Value="{Binding CursorZ, Mode=TwoWay}" Unit="px" StringFormat="F1" Delta="0.1" Min="-100000" Max="100000" DefaultMin="-1000" DefaultMax="1000" BeginEdit="Sidebar_Edit" EndEdit="Sidebar_Edit"/>
                        </Grid>
                        </StackPanel>

                        <TextBlock Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhenTrue}}" Text="編集モードに入るとパラメーターが表示されます" TextWrapping="Wrap" Foreground="#FFB0B0B0" Margin="6,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
