<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <!--
        3D表示は HwndHost（子ウィンドウ）なので、WPF の要素を重ねても必ず下に隠れ、
        その範囲のクリックも子ウィンドウが持っていく。操作は重ねずに行を分ける。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 背景は塗らずに、置かれている場所の色をそのまま使う。メニューバーと同じ見え方になる -->
        <ToolBarTray Grid.Row="0" IsLocked="True" Background="Transparent">
            <ToolBar ToolBarTray.IsLocked="True" Background="Transparent" Padding="2,0">
                <Button Content="カメラを追加"
                        Command="{Binding AddCameraCommand}"
                        IsEnabled="{Binding CanAddCamera}"
                        ToolTip="いまの再生位置に「3Dカメラ」アイテムを置きます。空いているレイヤーを下から探します。"
                        Padding="6,2"/>

                <Separator/>

                <CheckBox Content="ドラッグでカメラを動かす"
                          IsChecked="{Binding DrivesSceneCamera}"
                          VerticalAlignment="Center"
                          Margin="4,0"
                          ToolTip="入れると、ドラッグがカメラアイテムを直接動かします。外すと見る位置だけが動き、出力は変わりません。カメラアイテムが無い間は、常に見る位置だけが動きます。"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 3D表示 -->
        <ContentControl Grid.Row="1" Content="{Binding D3DHost}"/>
    </Grid>
</UserControl>
