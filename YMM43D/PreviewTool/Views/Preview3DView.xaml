<UserControl x:Class="YMM43D.PreviewTool.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YMM43D.PreviewTool.Views"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Black"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <!-- 3D表示 -->
        <ContentControl Content="{Binding D3DHost}" />

        <!-- 操作。3D表示に重ねて置く -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                Background="#B0000000" CornerRadius="4" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="カメラを追加"
                        Command="{Binding AddCameraCommand}"
                        IsEnabled="{Binding CanAddCamera}"
                        ToolTip="いまの再生位置に「3Dカメラ」アイテムを置きます。空いているレイヤーを下から探します。"
                        Padding="8,2"/>

                <CheckBox Content="ドラッグでカメラを動かす"
                          IsChecked="{Binding DrivesSceneCamera}"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          ToolTip="入れると、ドラッグがカメラアイテムを直接動かします。外すと見る位置だけが動き、出力は変わりません。"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
